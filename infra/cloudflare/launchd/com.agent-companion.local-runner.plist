<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.agent-companion.local-runner</string>
    <key>ProgramArguments</key>
    <array>
      <string>/usr/local/bin/pnpm</string>
      <string>--dir</string>
      <string>/ABSOLUTE/PATH/TO/agent-companion</string>
      <string>--filter</string>
      <string>@agent-companion/local-runner</string>
      <string>start</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
      <key>REMOTE_SERVER_URL</key>
      <string>https://mcp.example.com</string>
      <key>RUNNER_TOKEN</key>
      <string>set-this-in-a-user-specific-copy</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>/ABSOLUTE/PATH/TO/agent-companion</string>
    <key>StandardOutPath</key>
    <string>/tmp/agent-companion-local-runner.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/agent-companion-local-runner.err</string>
  </dict>
</plist>
