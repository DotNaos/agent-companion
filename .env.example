# Shared
ADMIN_EMAIL=admin@example.com

# Remote MCP server
PORT=8787 
GOOGLE_ALLOWED_CLIENT_IDS=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OIDC_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
REQUEST_TIMEOUT_MS=60000
LOG_LEVEL=info

# Local runner
REMOTE_SERVER_URL=https://mcp.example.com
RUNNER_ID=laptop-01
LOCAL_RUNNER_PORT=4317
CONFIG_PATH=$HOME/.agent-companion/config.json
TODO_STORE_PATH=$HOME/.agent-companion/todos.json
ACTIVITY_LOG_PATH=$HOME/.agent-companion/activity.log
DEFAULT_ALLOWED_ORIGINS=https://admin.example.com
DEFAULT_GOOGLE_CLIENT_IDS=your-google-oauth-client-id.apps.googleusercontent.com

# Desktop companion
DESKTOP_PORT=4318
DESKTOP_PUBLIC_BASE_URL=https://admin.example.com
USER_STORE_PATH=$HOME/.agent-companion/users.json
CLOUDFLARED_BIN=cloudflared
CLOUDFLARED_CONFIG_PATH=$HOME/.agent-companion/cloudflared/config.yml
