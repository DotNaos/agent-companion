{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true,
            "passThroughEnv": [
                "AGENT_COMPANION_DEV_SESSION_ID",
                "AGENT_COMPANION_DEV_SESSION_DIR"
            ]
        },
        "typecheck": {
            "dependsOn": ["^typecheck"]
        },
        "test": {
            "dependsOn": ["^build"]
        }
    }
}
