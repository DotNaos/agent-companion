{
    "name": "@agent-companion/desktop-companion",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "src/main/index.ts",
    "scripts": {
        "build": "vite build && tsc -p tsconfig.main.json",
        "dev": "node ../../scripts/run-with-dev-log.mjs @agent-companion/desktop-companion -- bash scripts/dev.sh",
        "start": "cross-env NODE_OPTIONS='--import tsx' electron .",
